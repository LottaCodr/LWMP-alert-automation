# Local development template — do not commit a populated .env file.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Development-only SQLite path. Production must use a managed PostgreSQL DATABASE_URL.
DATABASE_PATH=./data/living-water-alerts.db
DATABASE_URL=
# Optional direct, administration-only URL for migrations when DATABASE_URL uses a pooler.
MIGRATIONS_DATABASE_URL=

# Generate three distinct high-entropy values in Render's encrypted environment.
SESSION_SECRET=replace-with-a-long-random-session-secret
FIELD_ENCRYPTION_KEY=replace-with-distinct-long-random-encryption-material
PHONE_HASH_KEY=replace-with-distinct-long-random-hmac-key

# Public canonical HTTPS address. Required for passkeys in production.
APP_ORIGIN=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
TOTP_ISSUER=Living Water Mega Parish

# Keep mock while delivery providers are onboarding. Never treat mock delivery as a real alert.
# Production accepts only mock or live; live requires every Meta and Termii credential below.
MESSAGE_MODE=mock

# PostgreSQL delivery worker owns the schedule in production. Do not enable it in both web and worker.
SCHEDULER_ENABLED=false
PG_POOL_MAX=10
# Set require for a Supabase or other external TLS PostgreSQL connection.
PGSSLMODE=
# Leave true. Set false only for a deliberately verified development-only/self-signed endpoint.
PG_SSL_REJECT_UNAUTHORIZED=true
# Bound outbound Resend/Meta/Termii calls so a worker job can retry safely.
PROVIDER_REQUEST_TIMEOUT_MS=10000

# Staff invitation email: mock locally; resend in production after domain verification.
EMAIL_MODE=mock
RESEND_API_KEY=
INVITE_FROM_EMAIL=Living Water Birthday Care <birthday-care@your-parish-domain.org>

# Direct Meta WhatsApp Cloud API — use the parish-owned Business Portfolio/WABA only.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_BIRTHDAY_TEMPLATE=
META_TEMPLATE_LANGUAGE=en_US
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
META_APP_SECRET=

# Nigerian SMS and verification provider: Termii.
TERMII_API_KEY=
TERMII_SENDER_ID=
# Termii Events & Reports signs JSON webhooks with HMAC-SHA512 in X-Termii-Signature.
TERMII_WEBHOOK_SECRET=
TERMII_BASE_URL=https://v3.api.termii.com
# Use the approved transactional/DND route. Do not use generic for OTPs or critical alerts.
TERMII_SMS_CHANNEL=dnd
# Omit or set native to use Termii's server-verified OTP API in production; local uses a hashed code.
TERMII_OTP_MODE=native
