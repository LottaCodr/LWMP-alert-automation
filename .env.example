# Local development template — copy to `.env` and fill in. Never commit a
# populated `.env`, and never paste a real secret into chat or an issue.
#
# `server/config.ts` validates every variable at boot. In production the server
# REFUSES TO START if a required secret is missing, and names the variable.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# debug | info | warn | error. Defaults to debug in development, info in production.
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# postgresql://user:password@host:5432/database  — or pgmem:// for the
# in-memory PostgreSQL used by the demo runtime and the smoke test.
DATABASE_URL=
# Optional direct (non-pooled) URL used by migrations when DATABASE_URL points
# at a pooler that cannot run DDL.
MIGRATIONS_DATABASE_URL=
PG_POOL_MAX=10
# Set to `require` for Neon, Supabase and other TLS-only providers.
PGSSLMODE=
# Leave true. Set false only for a verified, development-only self-signed host.
PG_SSL_REJECT_UNAUTHORIZED=true

# --- Secrets ---------------------------------------------------------------
# Three DISTINCT high-entropy values. Generate with:
#   openssl rand -base64 48   # SESSION_SECRET
#   openssl rand -base64 32   # FIELD_ENCRYPTION_KEY
#   openssl rand -base64 32   # PHONE_HASH_KEY
# FIELD_ENCRYPTION_KEY encrypts member phone numbers: losing it makes stored
# numbers permanently unreadable. PHONE_HASH_KEY drives duplicate detection:
# rotating it breaks matching against previously stored numbers.
#
# No fallback is committed anywhere in this repository. Outside production, the
# in-memory `pgmem://` runtime generates fresh per-process values (its data does
# not outlive the process); any other DATABASE_URL refuses to start until these
# are set.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# --- Public addresses ------------------------------------------------------
# Canonical HTTPS origin of the deployed app (no trailing slash). Required for
# passkeys and for staff invitation links.
APP_ORIGIN=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
# Host only, no scheme. localhost for local development.
WEBAUTHN_RP_ID=localhost
TOTP_ISSUER=Living Water Mega Parish

# Comma-separated browser origins allowed to call the API with cookies. Set this
# ONLY for split hosting (e.g. https://your-app.vercel.app). Setting it switches
# the session cookie to SameSite=None; Secure, so both origins must be HTTPS.
# Leave empty when the API also serves the built SPA.
CORS_ORIGINS=

# --- Delivery --------------------------------------------------------------
# mock never contacts a provider. live requires every Meta/Termii value below
# and is refused at boot if any is missing.
MESSAGE_MODE=mock
# mock | resend. Production requires resend plus RESEND_API_KEY and INVITE_FROM_EMAIL.
EMAIL_MODE=mock
RESEND_API_KEY=
INVITE_FROM_EMAIL=Living Water Birthday Care <birthday-care@your-parish-domain.org>

# true runs the birthday cron inside the web process. REQUIRED on hosting that
# cannot run a background worker (Render free). Never enable it on more than one
# instance while a dedicated worker is also running.
SCHEDULER_ENABLED=false
# Seed fictional demo users/members. Only honoured outside production, and it
# enables the /api/auth/demo-accounts endpoint.
SEED_DEMO_DATA=false

# Bound outbound provider calls so a delivery job can be retried safely.
PROVIDER_REQUEST_TIMEOUT_MS=10000

# --- Meta WhatsApp Cloud API ----------------------------------------------
# Use the parish-owned Business Portfolio / WABA only.
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_BIRTHDAY_TEMPLATE=
META_TEMPLATE_LANGUAGE=en_US
META_GRAPH_VERSION=v23.0
# Shared with Meta when registering the webhook callback.
META_WEBHOOK_VERIFY_TOKEN=
# Signs inbound webhooks (HMAC-SHA256, X-Hub-Signature-256, over the raw body).
META_APP_SECRET=

# --- Termii (Nigerian SMS + endpoint OTP) ---------------------------------
TERMII_API_KEY=
TERMII_SENDER_ID=
# Signs delivery webhooks (HMAC-SHA512, X-Termii-Signature, over the raw body).
TERMII_WEBHOOK_SECRET=
TERMII_BASE_URL=https://v3.api.termii.com
# Use the approved transactional/DND route for alerts; never `generic`.
TERMII_SMS_CHANNEL=dnd
# native uses Termii's server-verified OTP API; local hashes a code in-process
# (development only).
TERMII_OTP_MODE=native

# --- Client (build time) ---------------------------------------------------
# Inlined into the SPA bundle by Vite, so a change requires a rebuild/redeploy.
# Set only when the SPA is hosted separately from the API (Vercel + Render):
#   VITE_API_BASE_URL=https://your-api.onrender.com
# Leave empty for same-origin hosting; the client then uses relative URLs.
VITE_API_BASE_URL=
