{
  "name": "living-water-alerts",
  "version": "1.0.0",
  "main": "build/server/entry.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --config client/vite.config.ts",
    "build": "npm run clean && npm run typecheck && npm run build:server && npm run build:client",
    "start": "node build/server/entry.js",
    "dev": "vite --config client/vite.config.ts",
    "dev:server": "tsx server/entry.ts",
    "worker": "node build/server/worker.js",
    "dev:worker": "tsx server/worker.ts",
    "migrate:postgres": "npm run build:server && node build/scripts/migrate-postgres.js",
    "import:sqlite:postgres": "npm run build:server && node build/scripts/import-sqlite-to-postgres.js",
    "bootstrap:owner": "npm run build:server && node build/scripts/bootstrap-owner.js",
    "smoke:postgres": "tsx scripts/smoke-test-postgres.ts",
    "test": "npm run typecheck && npm run smoke:postgres"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "libphonenumber-js": "^1.13.12",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "pg-mem": "^3.0.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
