{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"]
}
